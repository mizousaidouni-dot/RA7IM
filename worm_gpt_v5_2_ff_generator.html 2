<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>WormGPT v5.2 - FF Generator</title>
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
 <style>
:root { --bg-dark: #0f111a; --bg-panel: #1a1d29; --accent: #7c4dff; --text-main: #ffffff; --text-muted: #a0a0a0; --border: #2d3436; --success: #00e676; --error: #ff5252; }
 * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
 body { background-color: var(--bg-dark); color: var(--text-main); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; }
.navbar { background-color: var(--bg-panel); padding: 1rem 0; border-bottom: 1px solid var(--border); }
.container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center; }
.logo { font-size: 1.5rem; font-weight: bold; color: var(--accent); display: flex; align-items: center; gap: 10px; }
.main-content { padding: 2rem 0; flex: 1; max-width: 1200px; margin: 0 auto; width: 100%; padding-left: 2rem; padding-right: 2rem; }
.header-section { text-align: center; margin-bottom: 3rem; padding: 3rem 1rem; background: linear-gradient(135deg, var(--bg-panel) 0%, #232946 100%); border-radius: 12px; }
.main-title { font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--accent); }
.sub-title { color: var(--text-muted); font-size: 1.1rem; }

.config-section { display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem; }
.left-col,.right-col { background-color: var(--bg-panel); padding: 2rem; border-radius: 12px; border: 1px solid var(--border); }

.form-group { margin-bottom: 1.5rem; }
.form-group label { display: block; margin-bottom: 0.5rem; color: var(--text-muted); }
.form-control { width: 100%; padding: 0.75rem; background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; color: var(--text-main); }
.btn { padding: 0.75rem 1.5rem; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; background-color: var(--accent); color: white; width: 100%; display: flex; justify-content: center; align-items: center; gap: 0.5rem; }
.btn:disabled { background-color: var(--text-muted); cursor: not-allowed; }
.log-window { background-color: #000; border: 1px solid var(--border); border-radius: 6px; height: 200px; overflow-y: auto; padding: 1rem; font-family: monospace; font-size: 0.85rem; color: var(--success); }
.account-card { background-color: var(--bg-dark); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
.account-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-weight: bold; }
.account-details { font-size: 0.85rem; color: var(--text-muted); }
 </style>
</head>
<body>
 <nav class="navbar"><div class="container"><div class="logo"><i class="fa-solid fa-worm"></i> WormGPT v5.2</div></div></nav>

 <main class="main-content">
 <section class="header-section">
 <h1 class="main-title">Free Fire Generator</h1>
 <p class="sub-title">Real-time generation using Python Backend</p>
 </section>

 <section class="config-section">
 <div class="left-col">
 <div class="form-group">
 <label>Server Region</label>
 <select id="server-select" class="form-control">
 <option value="IND">India</option>
 <option value="BD">Bangladesh</option>
 <option value="SG">Singapore</option>
 <option value="ID">Indonesia</option>
 <option value="TH">Thailand</option>
 <option value="PK">Pakistan</option>
 <option value="ME">Middle East</option>
 <option value="VN">Vietnam</option>
 <option value="BR">Brazil</option>
 <option value="US">United States</option>
 </select>
 </div>
 <div class="form-group">
 <label>Quantity</label>
 <input type="number" id="account-count" class="form-control" value="1" min="1" max="10">
 </div>
 <button id="start-btn" class="btn"><i class="fa-solid fa-play"></i> Start Generation</button>
 </div>

 <div class="right-col">
 <div class="log-window" id="log-window">...</div>
 <div id="account-list"></div>
 </div>
 </section>
 </main>

 <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 <script>
 $(document).ready(function() {
 $('#start-btn').click(function() {
 const region = $('#server-select').val();
 const count = $('#account-count').val();
 const btn = $(this);
 const list = $('#account-list');
 const log = $('#log-window');

 btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Generating...');
 list.empty();
 log.html('<div>[SYSTEM] Request sent to Python backend...</div>');

 $.post('/api/generate', { region: region, count: count }, function(data) {
 if(data.success) {
 log.append('<div>[SUCCESS] Accounts generated!</div>');
 data.accounts.forEach(acc => {
 list.append(`
 <div class="account-card">
 <div class="account-header">
 <span>${acc.nickname}</span>
 <button class="btn" style="width:auto" onclick="copy('${acc.uid}')">Copy UID</button>
 </div>
 <div class="account-details">
 UID: ${acc.uid} | Pass: ${acc.password}
 </div>
 </div>
 `);
 });
 } else {
 log.append('<div>[ERROR] Failed to generate accounts.</div>');
 }
 btn.prop('disabled', false).html('<i class="fa-solid fa-play"></i> Start Generation');
 }).fail(function() {
 log.append('<div>[ERROR] Cannot connect to Python backend. Make sure app.py is running.</div>');
 btn.prop('disabled', false).html('<i class="fa-solid fa-play"></i> Start Generation');
 });
 });
 });
 
 function copy(text) {
 navigator.clipboard.writeText(text);
 alert('Copied!');
 }
 </script>
</body>
</html>